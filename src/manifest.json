{
   "manifest_version": 3,
   "name": "Separate Window Ex",
   "short_name": "SepWin",
   "version": "1.0.0",
   "description": "__MSG_extDesc__",
   "default_locale": "zh_CN",
   "author": "Kashimura",
   "minimum_chrome_version": "116",
   "icons": {
      "16": "img/icon16.png",
      "48": "img/icon48.png",
      "128": "img/icon128.png"
   },
   "action": {
      "default_icon": "img/icon128.png",
      "default_popup": "popup.html",
      "default_title": "Choose to separate window"
   },
   "background": {
      "service_worker": "js/background.js"
   },
   "permissions": [
      "tabs",
      "storage",
      "bookmarks",
      "webNavigation",
      "contextMenus",
      "scripting",
      "power"
   ],
   "host_permissions": [
      "http://*/*",
      "https://*/*"
   ],
   "content_scripts": [
      {
         "all_frames": false,
         "js": ["js/recorder.js"],
         "matches": ["http://*/*", "https://*/*"],
         "run_at": "document_start",
         "world": "MAIN"
      },
      {
         "all_frames": false,
         "css": ["css/icon.css"],
         "js": [
            "js/content.js",
            "js/player.js"
         ],
         "matches": ["http://*/*", "https://*/*"],
         "run_at": "document_start"
      }
   ],
   "web_accessible_resources": [
      {
         "resources": [
            "js/iframe.js",
            "css/iframe.css",
            "css/preview.css",
            "css/window.css",
            "css/video.css",
            "css/panel.css",
            "css/pip.css",
            "img/back.svg",
            "img/btn_up.svg",
            "img/btn_dwn.svg",
            "img/btn_resize_on.svg",
            "img/btn_resize_off.svg",
            "img/icon.svg",
            "img/volume.svg",
            "img/volume_off.svg",
            "img/fullscr_on.svg",
            "img/fullscr_off.svg",
            "img/camera.svg",
            "img/bookmark_on.svg",
            "img/bookmark_off.svg",
            "img/link.svg",
            "img/filters_ico.svg",
            "img/rotate.svg",
            "img/zoom.svg",
            "img/saturate.svg",
            "img/brightness.svg",
            "img/contrast.svg",
            "img/blur.svg",
            "img/reset.svg",
            "img/position.svg",
            "img/speed.svg",
            "img/btn_player_on.svg",
            "img/btn_player_off.svg",
            "img/save_size_on.svg",
            "img/save_size_off.svg",
            "img/pip_off.svg",
            "img/pip_on.svg"
         ],
         "matches": ["http://*/*", "https://*/*"]
      }
   ]
}
